# ---------------------------------------------------------------------------
# apps/api/.env  -  copy with:  cp apps/api/.env.example apps/api/.env
# NEVER commit the real .env file. Every value below is documented.
# ---------------------------------------------------------------------------

# --- Runtime --------------------------------------------------------------
# 'development' | 'test' | 'production'
NODE_ENV=development
# Port the API listens on.
PORT=3000
# Comma-separated list of browser origins allowed to call the API.
# In dev the Vite proxy makes this mostly redundant, but it must be correct in prod.
WEB_ORIGIN=http://localhost:5173

# --- Database -------------------------------------------------------------
# Local Docker Postgres (see docker-compose.yml at the repo root).
# In production this becomes a Neon/Supabase connection string.
DATABASE_URL=postgresql://fh:fh_dev_password@localhost:5432/family_heritage?schema=public

# --- Observability --------------------------------------------------------
# 'fatal' | 'error' | 'warn' | 'info' | 'debug' | 'trace'
LOG_LEVEL=debug
# Serve Swagger UI at /api/docs. Turn OFF in production.
SWAGGER_ENABLED=true

# --- AI (Phase 16 - leave disabled until then) ----------------------------
# Global kill switch. When false the /ai/* routes return 503 and the rest of
# the application is completely unaffected.
AI_ENABLED=false
# Provider API key. Server-side only - it must never reach the browser.
AI_API_KEY=
AI_MODEL=claude-sonnet-4-6

# --- Cloudinary (Phase 9 - leave blank until then) ------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
