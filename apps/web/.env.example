# ---------------------------------------------------------------------------
# apps/web/.env  -  copy with:  cp apps/web/.env.example apps/web/.env
# Anything prefixed VITE_ is compiled into the browser bundle and is PUBLIC.
# Never put a secret here.
# ---------------------------------------------------------------------------

# Base path for API calls. Left as a relative path in development so the Vite
# proxy handles it. In production set the full origin, e.g.
# https://family-heritage-api.onrender.com/api/v1
VITE_API_BASE_URL=/api/v1

# Where the dev proxy forwards /api requests. Change if the API is not on 3000.
VITE_API_PROXY_TARGET=http://localhost:3000
